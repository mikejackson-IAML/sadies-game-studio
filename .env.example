# Copy this file to .env and fill in the real key.
# .env is gitignored and must NEVER be committed.
#
# Get an API key at https://platform.worldlabs.ai/
# NOTE: API Platform credits are SEPARATE from marble.worldlabs.ai web-app credits.
WORLDLABS_API_KEY=wl-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Concept images for the World Design Studio (Google AI Studio).
# Optional: without it the design flow still runs, it just skips the pictures.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Higgsfield — her character art ("Soul ID"), consistent across world styles.
# Optional. BOTH are required if you use it. Get them from the Higgsfield
# platform, then run: npm run character:setup
# NOTE: platform.higgsfield.ai must be reachable from wherever this runs.
HIGGSFIELD_API_KEY=hf-xxxxxxxxxxxxxxxxxxxxxxxx
HIGGSFIELD_SECRET=hf-xxxxxxxxxxxxxxxxxxxxxxxx
